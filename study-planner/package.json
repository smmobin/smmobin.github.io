{
  "name": "study-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @study-planner/web",
    "dev:api": "npm run dev -w @study-planner/api",
    "dev:app": "node scripts/dev-app.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "test": "npm run test -w @study-planner/api",
    "test:api": "npm run test -w @study-planner/api",
    "test:server": "node server/test-server.mjs",
    "build": "npm run build -w @study-planner/web",
    "lint": "npm run lint -w @study-planner/web",
    "preview": "npm run preview -w @study-planner/web",
    "migrate": "npm run migrate -w @study-planner/api"
  }
}
